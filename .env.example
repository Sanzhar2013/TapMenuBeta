APP_ENV=development            # production на сервере
SECRET_KEY=change-me-long-random-string
DATABASE_URL=sqlite:///tapmenu.db   # на сервере: postgresql://user:pass@host/db
BASE_URL=http://localhost:5000      # публичный https-адрес, попадает в QR-коды
BOT_TOKEN=                          # токен бота от @BotFather (общий для всех кафе)
OWNER_USERNAME=owner
OWNER_PASSWORD=owner12345           # смените! создаёт владельца при первом запуске
TZ_OFFSET=5                         # часовой пояс (Алматы = +5)
